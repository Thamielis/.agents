{
  "App": {
    "Name": "PodeTool",
    "Version": "0.1.0"
  },
  "Server": {
    "Port": 8443,
    "BindAddress": "*",
    "Protocol": "Http",
    "BasePath": "/"
  },
  "Security": {
    "EnableHttps": false,
    "AllowCidrs": [
      "127.0.0.1/32"
    ],
    "RateLimit": {
      "Enabled": true,
      "Limit": 60,
      "Seconds": 60
    }
  },
  "Caching": {
    "DefaultTtlMinutes": 60
  },
  "Logging": {
    "Level": "Information"
  }
}