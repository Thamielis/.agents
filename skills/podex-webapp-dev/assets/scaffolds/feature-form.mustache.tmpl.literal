<div class="fixed inset-0 bg-black/40 flex items-center justify-center p-4">
  <div class="bg-white rounded-xl shadow-xl w-full max-w-lg">
    <div class="p-4 border-b flex items-center justify-between">
      <h2 class="font-semibold">{{FormTitle}}</h2>
      <button class="px-2 py-1 rounded border" hx-target="#Modal" hx-swap="innerHTML" hx-get="/__close">Close</button>
    </div>

    <form class="p-4 space-y-3"
          hx-post="/{{FeatureRoute}}/{{SubmitAction}}"
          hx-target="#Table"
          hx-swap="innerHTML">
      <input type="hidden" name="id" value="{{Id}}" />

      {{#Fields}}
      <div>
        <label class="block text-xs font-medium mb-1">{{Label}}</label>
        <input class="w-full px-3 py-2 rounded-lg border" name="{{Name}}" value="{{Value}}" />
        {{# /// optional inline error slot }}
        {{#Error}}<div class="text-xs text-red-600 mt-1">{{Error}}</div>{{/Error}}
      </div>
      {{/Fields}}

      <div class="pt-2 flex justify-end gap-2">
        <button type="button"
                class="px-3 py-2 rounded-lg border"
                hx-get="/__close"
                hx-target="#Modal"
                hx-swap="innerHTML">Cancel</button>

        <button type="submit" class="px-3 py-2 rounded-lg border">
          Save
        </button>
      </div>
    </form>
  </div>
</div>
